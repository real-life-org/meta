{
  "name": "@real-life/docs-kit",
  "version": "0.1.0",
  "description": "Shared kit for the Starlight documentation sites of the Real Life family. First module: a glossary with term popovers, fed by each project's SKOS term register.",
  "type": "module",
  "license": "CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/real-life-org/meta.git",
    "directory": "packages/docs-kit"
  },
  "keywords": [
    "astro-component",
    "starlight",
    "starlight-plugin",
    "glossary",
    "skos"
  ],
  "exports": {
    ".": "./src/index.js",
    "./Glossary.astro": "./src/glossary/Glossary.astro",
    "./glossary.css": "./src/glossary/glossary.css",
    "./hover.js": "./src/glossary/hover.js",
    "./load": "./src/glossary/load.js",
    "./remark": "./src/glossary/remark.js",
    "./mappings": "./src/glossary/mappings.js",
    "./satteri": "./src/glossary/satteri.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "audit": "npm audit --audit-level=low",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.42",
    "astro": "^7"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "satteri": "^0.10.5",
    "unified": "^11.0.5",
    "vfile": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
